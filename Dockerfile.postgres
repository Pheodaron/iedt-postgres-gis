# syntax=docker/dockerfile:1

FROM postgres:18-trixie@sha256:2ea8630df176ad090ec92136dee850397c5af8781e4bcf2e4162593691c61bbc

ARG POSTGIS_PACKAGE_VERSION=3.7.0+dfsg-1.pgdg13+2
ARG PGROUTING_PACKAGE_VERSION=4.0.2-1.pgdg13+2

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        "postgresql-18-postgis-3=${POSTGIS_PACKAGE_VERSION}" \
        "postgresql-18-postgis-3-scripts=${POSTGIS_PACKAGE_VERSION}" \
        "postgresql-18-pgrouting=${PGROUTING_PACKAGE_VERSION}" \
        "postgresql-18-pgrouting-scripts=${PGROUTING_PACKAGE_VERSION}" \
    && rm -rf /var/lib/apt/lists/*

COPY <<'SQL' /docker-entrypoint-initdb.d/10-spatial.sql
BEGIN;
CREATE EXTENSION postgis;
CREATE EXTENSION pgrouting;
COMMIT;
SQL

ENV POSTGRES_INITDB_ARGS="--auth-host=scram-sha-256 --auth-local=scram-sha-256"

HEALTHCHECK --interval=10s --timeout=3s --start-period=30s \
    CMD ["pg_isready", "-h", "127.0.0.1", "-t", "2"]
